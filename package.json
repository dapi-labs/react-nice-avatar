{
  "name": "@oniharnantyo/react-nice-avatar",
  "version": "0.1.0",
  "description": "react library for generating avatar",
  "keywords": [
    "avatar",
    "react",
    "react-avatar"
  ],
  "license": "MIT",
  "author": "Oni Harnantyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oniharnantyo/react-nice-avatar.git"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev --config vite.config.demo.ts",
    "build": "vp build",
    "build:demo": "vp build --config vite.config.demo.ts",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "format": "vp fmt",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "chroma-js": "^2.4.2",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@types/chroma-js": "^2.4.4",
    "@types/dom-to-image": "^2.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.8.1",
    "@types/prop-types": "^15.7.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "classnames": "^2.5.1",
    "dom-to-image": "^2.6.0",
    "file-saver": "^2.0.5",
    "jsdom": "^25.0.1",
    "nanoid": "^5.0.7",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.80.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite-plugin-dts": "^5.1.2",
    "vite-plus": "^1.3.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.8.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || ^24.11.0 || >=26.0.0",
      "onFail": "error"
    }
  }
}
